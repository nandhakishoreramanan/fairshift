# FairShift Environment Variables
# In production on Google Cloud Run, set these via Cloud Console or Secret Manager.
PORT=8080
NODE_ENV=production

# 32+ character secrets (if omitted, random cryptographic keys are generated at boot)
SESSION_SECRET=
ANON_SECRET=
KIOSK_SECRET=

# Demo PIN overrides (optional)
DEMO_WORKER_PIN=1234
DEMO_ADMIN_PIN=9999

# Google Cloud integrations (optional; uses Application Default Credentials on Cloud Run)
ENABLE_CLOUD_TRANSLATE=false
ENABLE_CLOUD_TTS=false
GOOGLE_CLOUD_PROJECT=

# Supabase (PostgreSQL) Integration (optional; if omitted, runs in-memory seeded mode)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-anon-or-service-key
